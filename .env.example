# Copy to .env and fill in. Never commit .env.

# --- Django ---
DJANGO_SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
DATABASE_URL=postgres://shop:shop@localhost:5432/shop
REDIS_URL=redis://localhost:6379/0
CACHE_URL=locmemcache://

# --- Shop rules ---
SHOP_DEFAULT_DELIVERY_FEE=5000
ORDER_REMINDER_MINUTES=30
ORDER_EXPIRY_MINUTES=120

# --- Object storage (optional, MinIO/S3). Leave S3_BUCKET empty to use local media/ ---
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- WhatsApp Cloud API (phase 4) ---
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_APP_SECRET=
WA_VERIFY_TOKEN=

# --- ClickPesa (phase 2; no sandbox, real money) ---
CLICKPESA_BASE_URL=https://api.clickpesa.com/third-parties
CLICKPESA_CLIENT_ID=
CLICKPESA_API_KEY=
CLICKPESA_CHECKSUM_KEY=

# --- Self-hosted AI on the GPU box (phase 3) ---
LLM_BASE_URL=http://gpu-box:8001/v1
LLM_MODEL=Qwen/Qwen3-VL-8B-Instruct
EMBED_BASE_URL=http://gpu-box:8002
WHISPER_BASE_URL=http://gpu-box:8003
SIGLIP_BASE_URL=http://gpu-box:8004
AI_API_KEY=
