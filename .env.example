# Copy to .env and fill in. Never commit .env.

# --- Django ---
DJANGO_SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
DATABASE_URL=postgres://shop:shop@localhost:5432/shop
REDIS_URL=redis://localhost:6379/0
CACHE_URL=locmemcache://

# --- Shop rules ---
SHOP_DEFAULT_DELIVERY_FEE=5000
ORDER_REMINDER_MINUTES=30
ORDER_EXPIRY_MINUTES=120

# --- Object storage (optional, MinIO/S3). Leave S3_BUCKET empty to use local media/ ---
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- WhatsApp Cloud API (004). Dev without Meta: WHATSAPP_FAKE_GRAPH=True logs outbound payloads. ---
# From Meta for Developers > WhatsApp > API setup. Webhook URL: https://<host>/api/whatsapp/webhook/
WHATSAPP_PHONE_NUMBER_ID=dev-number
# The shop's number in E.164; used for the wa.me link on the account page.
WHATSAPP_BUSINESS_NUMBER=+255700000000
# Permanent system-user token (never commit a real one).
WHATSAPP_ACCESS_TOKEN=
# App secret: signs every webhook POST (X-Hub-Signature-256).
WHATSAPP_APP_SECRET=dev-secret
# Any random string; also entered in the Meta webhook settings.
WHATSAPP_VERIFY_TOKEN=dev-verify
WHATSAPP_GRAPH_URL=https://graph.facebook.com
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_FAKE_GRAPH=True
# Approved UTILITY template names (sw + en each), see specs/004-whatsapp-channel/contracts/outbound.md
WHATSAPP_TEMPLATE_ORDER_PAID=order_paid
WHATSAPP_TEMPLATE_ORDER_OUT_FOR_DELIVERY=order_out_for_delivery
WHATSAPP_TEMPLATE_ORDER_DELIVERED=order_delivered
WHATSAPP_TEMPLATE_ORDER_CANCELLED=order_cancelled
WHATSAPP_TEMPLATE_ORDER_EXPIRED=order_expired
WHATSAPP_TEMPLATE_FOLLOW_UP=follow_up
# Per-number limits and behaviour
WHATSAPP_RATE_PER_MINUTE=10
WHATSAPP_RATE_PER_DAY=200
WHATSAPP_RESET_DAYS=7
WHATSAPP_VOICE_MAX_SECONDS=120
WHATSAPP_VOICE_MAX_BYTES=2097152
WHATSAPP_TEXT_LIMIT=4096
WHATSAPP_MAX_PRODUCT_PHOTOS=3

# --- Stakaba payments (sk_test_ = sandbox, sk_live_ = real money) ---
STAKABA_API_KEY=
STAKABA_BASE_URL=https://api.stakaba.com
# Random secret; set the dashboard webhook to https://<host>/api/payments/stakaba/webhook/<token>/
STAKABA_WEBHOOK_TOKEN=
STAKABA_CONFIRM_VIA_API=False

# --- Self-hosted AI (003). Any OpenAI-compatible server; switching is config-only. ---
# Dev (CPU): Ollama (`ollama pull qwen3:4b-instruct-2507-q4_K_M qwen2.5vl:3b bge-m3`) + `docker compose --profile ai up siglip`.
# The plain `qwen3:4b` tag is the 2507 *thinking* build: it reasons in the reply even with thinking off and times out on CPU.
# In docker-compose use http://host.docker.internal:11434/v1 instead of localhost.
# Prod (GPU box): AI_CHAT_BASE_URL=http://gpu:8000/v1 (vLLM), AI_CHAT_MODEL=Qwen/Qwen3-VL-8B-Instruct,
#   AI_CHAT_NO_THINK=False, AI_VISION_MODEL=Qwen/Qwen3-VL-8B-Instruct,
#   AI_EMBED_BASE_URL=http://gpu:8080/v1 (TEI), AI_EMBED_MODEL=BAAI/bge-m3, AI_CHAT_TIMEOUT=20
AI_CHAT_BASE_URL=http://localhost:11434/v1
AI_CHAT_MODEL=qwen3:4b-instruct-2507-q4_K_M
AI_CHAT_NO_THINK=True
AI_VISION_BASE_URL=
AI_VISION_MODEL=qwen2.5vl:3b
AI_EMBED_BASE_URL=http://localhost:11434/v1
AI_EMBED_MODEL=bge-m3
AI_IMAGE_EMBED_URL=http://localhost:8090
AI_API_KEY=ollama
AI_CHAT_TIMEOUT=90
AI_MAX_STEPS=6
AI_CHAT_MAX_TOKENS=600
# Voice notes (004): self-hosted faster-whisper sidecar (`docker compose --profile ai up whisper`).
# In docker-compose the backend uses AI_SPEECH_BASE_URL_DOCKER (default http://whisper:8091/v1).
# Prod (GPU box): AI_SPEECH_MODEL=large-v3
AI_SPEECH_BASE_URL=http://localhost:8091/v1
AI_SPEECH_MODEL=small
AI_SPEECH_TIMEOUT=120
