# Copy to .env and fill in. Never commit .env.

# --- Django ---
DJANGO_SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
DATABASE_URL=postgres://shop:shop@localhost:5432/shop
REDIS_URL=redis://localhost:6379/0
CACHE_URL=locmemcache://

# --- Shop rules ---
SHOP_DEFAULT_DELIVERY_FEE=5000
ORDER_REMINDER_MINUTES=30
ORDER_EXPIRY_MINUTES=120

# --- Object storage (optional, MinIO/S3). Leave S3_BUCKET empty to use local media/ ---
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- WhatsApp Cloud API (phase 4) ---
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_APP_SECRET=
WA_VERIFY_TOKEN=

# --- Stakaba payments (sk_test_ = sandbox, sk_live_ = real money) ---
STAKABA_API_KEY=
STAKABA_BASE_URL=https://api.stakaba.com
# Random secret; set the dashboard webhook to https://<host>/api/payments/stakaba/webhook/<token>/
STAKABA_WEBHOOK_TOKEN=
STAKABA_CONFIRM_VIA_API=False

# --- Self-hosted AI (003). Any OpenAI-compatible server; switching is config-only. ---
# Dev (CPU): Ollama (`ollama pull qwen3:4b-instruct-2507-q4_K_M qwen2.5vl:3b bge-m3`) + `docker compose --profile ai up siglip`.
# The plain `qwen3:4b` tag is the 2507 *thinking* build: it reasons in the reply even with thinking off and times out on CPU.
# In docker-compose use http://host.docker.internal:11434/v1 instead of localhost.
# Prod (GPU box): AI_CHAT_BASE_URL=http://gpu:8000/v1 (vLLM), AI_CHAT_MODEL=Qwen/Qwen3-VL-8B-Instruct,
#   AI_CHAT_NO_THINK=False, AI_VISION_MODEL=Qwen/Qwen3-VL-8B-Instruct,
#   AI_EMBED_BASE_URL=http://gpu:8080/v1 (TEI), AI_EMBED_MODEL=BAAI/bge-m3, AI_CHAT_TIMEOUT=20
AI_CHAT_BASE_URL=http://localhost:11434/v1
AI_CHAT_MODEL=qwen3:4b-instruct-2507-q4_K_M
AI_CHAT_NO_THINK=True
AI_VISION_BASE_URL=
AI_VISION_MODEL=qwen2.5vl:3b
AI_EMBED_BASE_URL=http://localhost:11434/v1
AI_EMBED_MODEL=bge-m3
AI_IMAGE_EMBED_URL=http://localhost:8090
AI_API_KEY=ollama
AI_CHAT_TIMEOUT=90
AI_MAX_STEPS=6
AI_CHAT_MAX_TOKENS=600
# Phase 4 (voice notes):
WHISPER_BASE_URL=
